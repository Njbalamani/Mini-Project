# ---------------------------------------------------------------------------
# NexaMind example environment file.
# Copy to ".env" and adjust. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database --------------------------------------------------------------
# DB_ENGINE: sqlite | postgresql | mysql
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Used when DB_ENGINE=postgresql (recommended for production)
DB_NAME=nexamind
DB_USER=nexamind
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email -----------------------------------------------------------------
# Defaults to the console backend. Use SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=NexaMind <no-reply@nexamind.local>

# --- Celery / Redis --------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Leave true for local dev so jobs run inline without a broker.
CELERY_TASK_ALWAYS_EAGER=true

# --- Cache -----------------------------------------------------------------
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=nexamind-cache

# --- Real-time notifications (Channels) ------------------------------------
# Dev: in-memory layer (single process). Prod: channels_redis + Redis URL.
# CHANNEL_BACKEND=channels.layers.InMemoryChannelLayer
# CHANNEL_BACKEND=channels_redis.core.RedisChannelLayer
CHANNEL_BACKEND=channels.layers.InMemoryChannelLayer
CHANNEL_REDIS_URL=redis://localhost:6379/1

# --- AI provider -----------------------------------------------------------
# AI_PROVIDER: (empty) | openai | gemini | mock
# "mock" is an explicit offline demo provider; empty means "not configured".
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT=45
AI_MAX_TOKENS=1024

# --- OAuth integrations ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Fernet key used to encrypt stored OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Application limits ----------------------------------------------------
MAX_DOCUMENT_UPLOAD_MB=10
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
# 0 disables idle-session logout
SESSION_IDLE_MINUTES=0
SESSION_COOKIE_AGE=1209600

# --- API throttling --------------------------------------------------------
API_USER_THROTTLE=1000/hour
API_ASSISTANT_THROTTLE=60/hour
API_SENSITIVE_THROTTLE=20/hour

# --- Misc ------------------------------------------------------------------
SITE_NAME=NexaMind
LOG_LEVEL=INFO
